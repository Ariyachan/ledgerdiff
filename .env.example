# Local PostgreSQL database, separate from any customer database.
DATABASE_URL=postgresql://ledgerdiff:replace_me@127.0.0.1:5544/ledgerdiff
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_at_least_32_random_characters
PORT=4200
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5174
# Set true only behind HTTPS. Local HTTP must use false.
COOKIE_SECURE=false
# Only needed for the optional independent Docker Compose stack:
POSTGRES_PASSWORD=replace_with_a_local_database_password
